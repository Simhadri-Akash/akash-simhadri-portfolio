# Copy this file to apps/api/.env for local development — `pnpm --filter
# @workspace/api-server dev` loads it automatically (if present) via Node's
# --env-file-if-exists flag. Never commit the real .env file or real values.

# Required: PostgreSQL persistence and readiness checks.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Required in production: the public portfolio origin allowed by CORS.
FRONTEND_ORIGIN="https://akashsimhadri.com"

# Optional infrastructure settings. Most hosting providers inject PORT
# automatically; it defaults to 8080 for local development if unset.
PORT="8080"
TRUST_PROXY_HOPS="1"
LOG_LEVEL="info"

# Optional AI provider. Missing credentials keep the deterministic local fallback active.
# Supported values: "openai" or "gemini".
AI_PROVIDER="openai"

# OpenAI-specific optional configuration.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# Gemini-specific optional configuration.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional Resend notification configuration. Contact persistence does not require it.
RESEND_API_KEY=""
CONTACT_TO_EMAIL=""
CONTACT_FROM_EMAIL=""
