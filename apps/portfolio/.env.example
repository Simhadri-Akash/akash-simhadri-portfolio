# Optional. Base URL the frontend prepends to relative "/api/..." requests.
#
# - Leave unset (or empty) for same-origin deployments, where the frontend
#   and API are served from the same origin — requests stay relative.
# - Set to the API's origin when the frontend and API are hosted separately.
#
# Local development (API running via `pnpm --filter @workspace/api-server dev`):
VITE_API_BASE_URL="http://localhost:8080"
